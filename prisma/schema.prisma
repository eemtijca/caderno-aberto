// Esquema do banco. Fonte da verdade para o Prisma Client.
// As políticas RLS e os gatilhos vivem nas migrações SQL.
//
// Objetos mantidos apenas no SQL, porque o Prisma Migrate não os representa:
// - Restrições CHECK (notas.status, links.tipo, tokens.tipo e alvo de links).
// - Índice único funcional usuarios_email_unico em lower(email).
// - Extensões pgcrypto e citext.
// - Funções, gatilhos e políticas RLS.
// Não "corrija" essas divergências no schema: elas são intencionais.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuarios {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email               String
  senhaHash           String               @default("") @map("senha_hash")
  papel               String               @default("professor")
  ativadoEm           DateTime?            @map("ativado_em") @db.Timestamptz
  criadoEm            DateTime             @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm        DateTime             @default(now()) @map("atualizado_em") @db.Timestamptz
  perfil              Profiles?
  sessoes             Sessoes[]
  codigos             CodigosAcesso[]      @relation("CodigoUsuario")
  codigosCriados      CodigosAcesso[]      @relation("CodigoCriador")
  solicitacoesAtendeu SolicitacoesAcesso[] @relation("SolicitacaoAtendida")
  eventos             EventosSeguranca[]

  @@map("usuarios")
}

// Perfil 1:1 com Usuarios; expira_em marca a exclusão programada.
model Profiles {
  id                   String        @id @db.Uuid
  nome                 String        @default("")
  email                String        @default("")
  escola               String        @default("")
  preferencias         Json          @default("{}") @db.JsonB
  criadoEm             DateTime      @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm         DateTime      @default(now()) @map("atualizado_em") @db.Timestamptz
  exclusaoSolicitadaEm DateTime?     @map("exclusao_solicitada_em") @db.Timestamptz
  expiraEm             DateTime?     @map("expira_em") @db.Timestamptz
  usuario              Usuarios      @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  disciplinas          Disciplinas[]
  turmas               Turmas[]
  notas                Notas[]
  links                Links[]

  @@map("profiles")
}

model Disciplinas {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  professorId  String   @map("professor_id") @db.Uuid
  nome         String
  cor          String   @default("verde")
  icone        String   @default("BookOpen")
  ordem        Int      @default(0)
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm DateTime @default(now()) @map("atualizado_em") @db.Timestamptz
  professor    Profiles @relation(fields: [professorId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  notas        Notas[]
  links        Links[]

  @@unique([professorId, nome], map: "disciplinas_professor_nome_unico")
  @@index([professorId], map: "disciplinas_professor_idx")
  @@map("disciplinas")
}

model Turmas {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  professorId  String   @map("professor_id") @db.Uuid
  nome         String
  serie        String   @default("Outro")
  anoLetivo    Int      @default(dbgenerated("(EXTRACT(year FROM now()))::integer")) @map("ano_letivo")
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm DateTime @default(now()) @map("atualizado_em") @db.Timestamptz
  professor    Profiles @relation(fields: [professorId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  links        Links[]

  @@unique([professorId, nome, anoLetivo], map: "turmas_professor_ano_unico")
  @@index([professorId, anoLetivo], map: "turmas_professor_idx")
  @@map("turmas")
}

// Campos de disciplina e turma são denormalizados para a vista pública.
model Notas {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  professorId    String       @map("professor_id") @db.Uuid
  titulo         String       @default("Sem título")
  disciplinaId   String?      @map("disciplina_id") @db.Uuid
  disciplinaNome String       @default("") @map("disciplina_nome")
  disciplinaCor  String       @default("verde") @map("disciplina_cor")
  turmasIds      String[]     @default([]) @map("turmas_ids")
  turmasNomes    String[]     @default([]) @map("turmas_nomes")
  anoLetivo      Int          @default(dbgenerated("(EXTRACT(year FROM now()))::integer")) @map("ano_letivo")
  mes            Int          @default(dbgenerated("(EXTRACT(month FROM now()))::integer"))
  sobre          String       @default("")
  habilidades    String       @default("")
  status         String       @default("rascunho")
  blocos         Json         @default("[]") @db.JsonB
  aparencia      Json         @default("{}") @db.JsonB
  busca          String       @default("")
  criadoEm       DateTime     @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm   DateTime     @default(now()) @map("atualizado_em") @db.Timestamptz
  disciplina     Disciplinas? @relation(fields: [disciplinaId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  professor      Profiles     @relation(fields: [professorId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  links          Links[]

  @@index([professorId, anoLetivo(sort: Desc), mes(sort: Desc)], map: "notas_professor_ano_mes_idx")
  @@index([professorId, atualizadoEm(sort: Desc)], map: "notas_professor_atualizado_idx")
  @@index([professorId, disciplinaId], map: "notas_professor_disciplina_idx")
  @@index([professorId, status], map: "notas_professor_status_idx")
  @@index([turmasIds], type: Gin, map: "notas_turmas_ids_idx")
  @@map("notas")
}

// token é o segredo do link público; o índice cobre a busca por token.
model Links {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  professorId       String       @map("professor_id") @db.Uuid
  tipo              String
  notaId            String?      @map("nota_id") @db.Uuid
  turmaId           String?      @map("turma_id") @db.Uuid
  disciplinaId      String?      @map("disciplina_id") @db.Uuid
  token             String       @unique(map: "links_token_key")
  professorNome     String       @default("") @map("professor_nome")
  nome              String       @default("")
  ativo             Boolean      @default(true)
  pausadoNaExclusao Boolean      @default(false) @map("pausado_na_exclusao")
  expiraEm          DateTime?    @map("expira_em") @db.Timestamptz
  acessos           Int          @default(0)
  criadoEm          DateTime     @default(now()) @map("criado_em") @db.Timestamptz
  professor         Profiles     @relation(fields: [professorId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  nota              Notas?       @relation(fields: [notaId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  turma             Turmas?      @relation(fields: [turmaId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  disciplina        Disciplinas? @relation(fields: [disciplinaId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([professorId], map: "links_professor_idx")
  @@index([notaId], map: "links_nota_idx")
  @@index([turmaId], map: "links_turma_idx")
  @@index([disciplinaId], map: "links_disciplina_idx")
  @@index([token], map: "links_token_idx")
  @@map("links")
}

model Sessoes {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId   String   @map("usuario_id") @db.Uuid
  tokenHash   String   @unique(map: "sessoes_token_hash_key") @map("token_hash")
  criadoEm    DateTime @default(now()) @map("criado_em") @db.Timestamptz
  expiraEm    DateTime @map("expira_em") @db.Timestamptz
  ultimoUsoEm DateTime @default(now()) @map("ultimo_uso_em") @db.Timestamptz
  ip          String   @default("")
  agente      String   @default("")
  usuario     Usuarios @relation(fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([usuarioId], map: "sessoes_usuario_idx")
  @@index([expiraEm], map: "sessoes_expira_idx")
  @@map("sessoes")
}

model CodigosAcesso {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId  String    @map("usuario_id") @db.Uuid
  email      String
  tipo       String
  codigoHash String    @map("codigo_hash")
  criadoPor  String?   @map("criado_por") @db.Uuid
  expiraEm   DateTime  @map("expira_em") @db.Timestamptz
  usadoEm    DateTime? @map("usado_em") @db.Timestamptz
  criadoEm   DateTime  @default(now()) @map("criado_em") @db.Timestamptz
  usuario    Usuarios  @relation("CodigoUsuario", fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  criador    Usuarios? @relation("CodigoCriador", fields: [criadoPor], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([email], map: "codigos_acesso_email_idx")
  @@index([expiraEm], map: "codigos_acesso_expira_idx")
  @@map("codigos_acesso")
}

// Fila de pedidos de acesso feitos na tela de login.
model SolicitacoesAcesso {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome       String    @default("")
  email      String
  tipo       String
  status     String    @default("pendente")
  atendidaPor String?  @map("atendida_por") @db.Uuid
  atendidaEm DateTime? @map("atendida_em") @db.Timestamptz
  criadoEm   DateTime  @default(now()) @map("criado_em") @db.Timestamptz
  atendente  Usuarios? @relation("SolicitacaoAtendida", fields: [atendidaPor], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([status, criadoEm(sort: Desc)], map: "solicitacoes_acesso_status_idx")
  @@map("solicitacoes_acesso")
}

// Trilha de auditoria dos eventos sensiveis.
model EventosSeguranca {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  atorId   String?  @map("ator_id") @db.Uuid
  acao     String
  email    String   @default("")
  ip       String   @default("")
  agente   String   @default("")
  detalhe  Json     @default("{}") @db.JsonB
  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz
  ator     Usuarios? @relation(fields: [atorId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([criadoEm(sort: Desc)], map: "eventos_seguranca_criado_idx")
  @@index([email], map: "eventos_seguranca_email_idx")
  @@map("eventos_seguranca")
}

// Janela do limite de tentativas por (chave, feita_em); a chave une rota e IP.
model TentativasLimite {
  chave   String   @map("chave")
  feitaEm DateTime @default(now()) @map("feita_em") @db.Timestamptz

  @@id([chave, feitaEm], map: "tentativas_limite_pkey")
  @@index([feitaEm], map: "tentativas_limite_feita_idx")
  @@map("tentativas_limite")
}
