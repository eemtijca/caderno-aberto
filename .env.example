# Caderno Aberto. Variáveis de ambiente.
# Copie para .env.local (desenvolvimento) ou configure na plataforma de deploy (produção).

# URL do projeto Supabase (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública (anon/publishable) — Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-aqui

# Versão da aplicação (opcional, padrão do package.json)
NEXT_PUBLIC_APP_VERSION=0.1.0

# Chave de serviço (service_role). Nunca exponha no navegador.
# Usada apenas no servidor (exclusão de conta, imagens públicas).
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui
