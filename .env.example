# Caderno Aberto. Variáveis de ambiente.
# Copie para .env (desenvolvimento local sem Docker) ou preencha no
# provedor de deploy (produção). Com Docker Compose, defina apenas
# AUTH_SECRET; o restante segue o padrão do compose.yml.

# Conexão com o PostgreSQL. Aponta para o Compose (db:5432) ou para
# qualquer PostgreSQL padrão. Use a conexão direta :5432 ou o pooler
# de sessão :5432; o pooler de transação :6543 é incompatível com
# instruções preparadas.
DATABASE_URL=postgresql://caderno:caderno@localhost:5432/caderno

# Conexão do CLI Prisma (migrações). Obrigatória onde o runtime usa o
# pooler de transação :6543 (Supabase); use o pooler de sessão :5432.
# DIRECT_URL=postgresql://usuario.projeto:senha@aws-0-regiao.pooler.supabase.com:5432/banco

# Segredo da sessão (JWT). Gere com: openssl rand -base64 32
AUTH_SECRET=troque-este-segredo-por-um-aleatorio-de-32-bytes

# Segredo do agendador (purga). Gere com: openssl rand -base64 32
# A Vercel envia automaticamente como Authorization no Cron.
# Obrigatório em produção; sem ele, a aplicação nem inicia.
CRON_SECRET=

# Origem pública da aplicação (links públicos e comparação de host no CSRF).
# Obrigatória em produção; sem ela, a origem usa o host do pedido.
# APP_URL=https://app.exemplo.br

# Acesso por código gerido pela administração, sem e-mail.
# Crie o primeiro admin com `npm run criar-admin` e as variáveis abaixo.
# ADMIN_EMAIL=admin@escola.br
# ADMIN_SENHA=uma-senha-forte
# ADMIN_NOME=Administração

# Validade do código de acesso, em minutos (padrão 60).
# CODIGO_EXPIRA_MINUTOS=60

# Armazenamento de imagens: disco local (padrão) ou API S3-compatível
# (MinIO, R2 ou qualquer provedor S3). O bucket precisa existir com os
# tipos de imagem permitidos.
# STORAGE_DRIVER=disk|s3
STORAGE_DRIVER=disk
UPLOAD_DIR=/data/imagens

# Somente com STORAGE_DRIVER=s3.
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_REGION=
# STORAGE_S3_BUCKET=
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=

# Limites de tentativas por IP a cada 5 minutos (padrão 30) e de
# verificação de código por e-mail (padrão 5).
# AUTH_LIMITE_TENTATIVAS=30
# AUTH_LIMITE_CODIGO=5

# Versão exibida na interface (opcional, padrão do package.json).
NEXT_PUBLIC_APP_VERSION=0.1.0
