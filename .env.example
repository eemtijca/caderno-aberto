# Caderno Aberto. Variáveis de ambiente.
# Copie para .env (desenvolvimento local sem Docker) ou preencha no
# provedor de deploy (produção). Com Docker Compose, defina apenas
# AUTH_SECRET; o restante segue o padrão do compose.yml.

# Conexão com o PostgreSQL. Aponta para o Compose (db:5432) ou para
# qualquer PostgreSQL padrão. Use a conexão direta :5432 ou o pooler
# de sessão :5432; o pooler de transação :6543 é incompatível com
# instruções preparadas.
DATABASE_URL=postgresql://caderno:caderno@localhost:5432/caderno

# Segredo da sessão (JWT). Gere com: openssl rand -base64 32
AUTH_SECRET=troque-este-segredo-por-um-aleatorio-de-32-bytes

# Segredo do agendador (purga). Gere com: openssl rand -base64 32
# A Vercel envia automaticamente como Authorization no Cron.
# Sem ele, a purga manual fica aberta (só development).
CRON_SECRET=

# Provedor de e-mail: log (console, padrão local), smtp (qualquer
# servidor SMTP) ou resend (API da Resend).
EMAIL_DRIVER=log

# Remetente exibido nos e-mails. Em produção, use um domínio verificado.
EMAIL_FROM=Caderno Aberto <contato@exemplo.br>

# Somente com EMAIL_DRIVER=smtp. Exemplos:
#   Mailpit local: smtp://localhost:1025
#   Resend via SMTP: smtp://resend:SUA-CHAVE@smtp.resend.com:587
SMTP_URL=

# Somente com EMAIL_DRIVER=resend. Crie em resend.com/api-keys
# (permissão "Sending access", restrita ao domínio de envio).
RESEND_API_KEY=

# Armazenamento de imagens: disco local (padrão) ou API S3-compatível
# (Supabase Storage, MinIO, R2). O bucket precisa existir com os
# tipos de imagem permitidos.
# STORAGE_DRIVER=disk|s3
STORAGE_DRIVER=disk
UPLOAD_DIR=/data/imagens

# Somente com STORAGE_DRIVER=s3.
# Supabase local: endpoint http://127.0.0.1:54321/storage/v1/s3, região
# local, bucket imagens, chaves do protocolo S3 do Storage.
# Supabase cloud: endpoint https://<ref>.storage.supabase.co/storage/v1/s3,
# região e chaves da página S3 Configuration do dashboard.
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_REGION=
# STORAGE_S3_BUCKET=
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=

# Versão exibida na interface (opcional, padrão do package.json).
NEXT_PUBLIC_APP_VERSION=0.1.0

# Caixa de e-mails de teste (/api/teste/outbox). Somente testes locais e
# CI; nunca defina como 1 em produção (expõe tokens de confirmação).
# ALLOW_TEST_OUTBOX=1
