# Exemplo de backend remoto. Crie o bucket e a tabela de bloqueio antes de
# rodar terraform init -backend-config=backend.hcl.

bucket       = "caderno-aberto-tfstate-000000000000"
key          = "caderno-aberto/aws/terraform.tfstate"
region       = "us-east-1"
encrypt      = true
use_lockfile = true
