{
  "name": "caderno-aberto",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tsc": "tsc --noEmit",
    "test": "vitest run",
    "test:api": "node prisma/scripts/aplicar-rls-teste.mjs && vitest run tests/api/isolamento.test.ts",
    "test:contratos": "vitest run tests/api/contratos.test.ts",
    "test:codigos": "vitest run tests/api/codigos.test.ts tests/api/admin.test.ts",
    "test:seguranca": "vitest run tests/api/seguranca.test.ts tests/api/sessao.test.ts",
    "test:destrutivas": "vitest run tests/api/destrutivas.test.ts",
    "test:unit": "vitest run tests/unit",
    "criar-admin": "node scripts/criar-admin.mjs",
    "seed": "node scripts/seed.mjs",
    "postinstall": "node scripts/copy-tikzjax.mjs && node scripts/copiar-swagger-ui.mjs && prisma generate",
    "lint:api": "redocly lint docs/openapi.json",
    "test:e2e": "playwright test",
    "test:e2e:docker": "bash tests/playwright-container.sh",
    "test:e2e:docker:chromium": "bash tests/playwright-container.sh --project=chromium",
    "test:e2e:install": "playwright install --with-deps chromium firefox webkit",
    "test:e2e:ui": "playwright test --ui",
    "capturas:readme": "playwright test e2e/imagens.spec.ts --project=chromium",
    "capturas:readme:docker": "bash tests/playwright-container.sh e2e/imagens.spec.ts --project=chromium",
    "etiquetas:sync": "node scripts/sincronizar-etiquetas.mjs",
    "contract:emit": "prisma generate",
    "vercel-build": "prisma generate && next build",
    "infra:fmt": "terraform fmt -recursive infra/terraform",
    "infra:validar": "bash infra/terraform/validar.sh",
    "infra:floci": "bash infra/floci/testar.sh",
    "infra:floci:aws": "bash infra/floci/testar.sh aws",
    "infra:floci:azure": "bash infra/floci/testar.sh azure",
    "infra:floci:gcp": "bash infra/floci/testar.sh gcp"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "@azure/identity": "^4.14.0",
    "@azure/storage-blob": "^12.34.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
